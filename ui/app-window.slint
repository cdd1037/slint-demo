export component AppWindow inherits Window {
    in-out property<int> counter: 0;
    callback increment();
    callback reset();

    title: "Slint Windows x64 Demo";
    width: 420px;
    height: 260px;
    background: #f6f7f9;

    Text {
        x: 24px;
        y: 22px;
        width: parent.width - 48px;
        height: 34px;
        text: "Slint Windows x64";
        font-size: 26px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 24px;
        y: 62px;
        width: parent.width - 48px;
        height: 24px;
        text: "minimal size benchmark";
        color: #666;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 24px;
        y: 100px;
        width: parent.width - 48px;
        height: 58px;
        border-radius: 8px;
        background: white;

        Text {
            text: "Counter: " + root.counter;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 24px;
        y: 178px;
        width: 180px;
        height: 48px;
        border-radius: 6px;
        background: #2764d8;

        Text {
            text: "+1 (Rust callback)";
            color: white;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.increment(); }
        }
    }

    Rectangle {
        x: 216px;
        y: 178px;
        width: 180px;
        height: 48px;
        border-radius: 6px;
        background: #e4e7ec;

        Text {
            text: "Reset";
            color: #222;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.reset(); }
        }
    }
}
